  );
}

function AdmitPatientModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [patient, setPatient] = useState(""); const [ward, setWard] = useState("ICU"); const [attending, setAttending] = useState(""); const [condition, setCondition] = useState("stable"); const [discharge, setDischarge] = useState("");
  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p) { pushToast({ title: "Select patient", variant: "warning" }); return; }
    logActivity({ action: "Admitted patient", category: "ipd", details: `${p.name} → ${ward} (${condition})` });
    pushToast({ title: "Patient Admitted ✓", description: `${p.name} → ${ward}`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="Admit Patient to IPD" subtitle="Assign bed and attending doctor" icon={BedDouble} onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Admit Patient" icon={CheckCircle2} />}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Patient</Label><select value={patient} onChange={(e) => setPatient(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{PATIENTS.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Ward</Label><select value={ward} onChange={(e) => setWard(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>ICU</option><option>CCU</option><option>General Ward A</option><option>General Ward B</option><option>Pediatric</option><option>Maternity</option></select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Attending Doctor</Label><select value={attending} onChange={(e) => setAttending(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Condition</Label><select value={condition} onChange={(e) => setCondition(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="stable">Stable</option><option value="observation">Observation</option><option value="serious">Serious</option><option value="critical">Critical</option></select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Expected Discharge</Label><Input type="date" value={discharge} onChange={(e) => setDischarge(e.target.value)} className="h-9 mt-1" /></div>
      </div>
    </ModalShell>
  );
}

