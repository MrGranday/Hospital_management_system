  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
} from "@/components/ui/select";
import { cn } from "@/lib/utils";

const money = (n: number) => `$${n.toFixed(2)}`;

// Inline print helpers
function openPrintWindow(html: string) {
  const w = window.open("", "_blank", "width=800,height=900");
  if (w) { w.document.write(html); w.document.close(); }
}

function printDoc(opts: { title: string; docType: string; docNum: string; patient: string; mrn: string; date: string; body: string; footer?: string; }) {
  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${opts.title}</title>
<style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#1a202c;background:#fff;padding:40px;font-size:14px}
.header{display:flex;justify-content:space-between;border-bottom:3px solid #0c5edc;padding-bottom:20px;margin-bottom:30px}
.hospital-info h1{color:#0c5edc;font-size:24px;font-weight:700}.hospital-info p{color:#64748b;font-size:12px}
.doc-type{text-align:right}.doc-type .label{color:#0c5edc;font-size:11px;text-transform:uppercase;font-weight:600}.doc-type .number{font-size:20px;font-weight:700;margin-top:4px}.doc-type .date{color:#64748b;font-size:12px;margin-top:4px}
.patient-bar{background:#f0f7ff;border-left:4px solid #0c5edc;padding:12px 16px;margin-bottom:24px;border-radius:4px}.patient-bar .name{font-size:16px;font-weight:600}.patient-bar .mrn{color:#64748b;font-size:12px}
.content{margin-bottom:30px}.content table{width:100%;border-collapse:collapse;margin-top:12px}.content th{background:#f8fafc;color:#475569;font-size:11px;text-transform:uppercase;text-align:left;padding:10px 12px;border-bottom:2px solid #e2e8f0}.content td{padding:10px 12px;border-bottom:1px solid #e2e8f0}
.text-right{text-align:right}.total-section{margin-top:20px;padding:16px 20px;background:#f8fafc;border-radius:8px;border-left:4px solid #0c5edc}.total-section .row{display:flex;justify-content:space-between;padding:4px 0}.total-section .row.grand{border-top:2px solid #e2e8f0;margin-top:8px;padding-top:12px;font-size:18px;font-weight:700;color:#0c5edc}
.signature-section{display:flex;justify-content:space-between;margin-top:50px}.signature-block{text-align:center}.signature-block .line{border-top:1px solid #475569;width:200px;margin-bottom:8px}.signature-block .label{color:#64748b;font-size:12px}
.footer{margin-top:40px;padding-top:20px;border-top:1px solid #e2e8f0;text-align:center;color:#94a3b8;font-size:11px}
.rx-symbol{font-size:32px;font-weight:700;color:#0c5edc;font-family:Georgia,serif;margin-bottom:16px}
@media print{.no-print{display:none}}
</style></head><body>
<button class="no-print" onclick="window.print()" style="position:fixed;top:20px;right:20px;background:#0c5edc;color:#fff;border:none;padding:10px 20px;border-radius:8px;cursor:pointer">Print</button>
<div class="header"><div class="hospital-info"><h1>San Francisco Medical Center</h1><p>100 Medical Plaza, San Francisco, CA 94143</p><p>Tel: +1 (415) 555-0100</p></div><div class="doc-type"><div class="label">${opts.docType}</div><div class="number">${opts.docNum}</div><div class="date">Date: ${opts.date}</div></div></div>
<div class="patient-bar"><div class="name">${opts.patient}</div><div class="mrn">MRN: ${opts.mrn}</div></div>
<div class="content">${opts.body}</div>
<div class="signature-section"><div class="signature-block"><div class="line"></div><div class="label">Patient Signature</div></div><div class="signature-block"><div class="line"></div><div class="label">Authorized Signature</div></div></div>
<div class="footer">${opts.footer || "This is a computer-generated document."}<br/>Generated by MediCore HMS on ${new Date().toLocaleString()}</div>
<script>setTimeout(()=>{window.print()},500)</script>
</body></html>`;
  openPrintWindow(html);
}

function inlinePrintReceipt(sale: { invoice: string; customer: string; time: string; paymentMethod: string; items: { name: string; qty: number; price: number }[]; total: number; }) {
  const subtotal = sale.items.reduce((s, i) => s + i.price * i.qty, 0);
  const tax = sale.total - subtotal;
  const body = `<table><thead><tr><th>Item</th><th class="text-right">Qty</th><th class="text-right">Price</th><th class="text-right">Total</th></tr></thead><tbody>${sale.items.map(i => `<tr><td>${i.name}</td><td class="text-right">${i.qty}</td><td class="text-right">$${i.price.toFixed(2)}</td><td class="text-right">$${(i.price*i.qty).toFixed(2)}</td></tr>`).join("")}</tbody></table><div class="total-section"><div class="row"><span>Subtotal</span><span>$${subtotal.toFixed(2)}</span></div><div class="row"><span>Tax (8%)</span><span>$${tax.toFixed(2)}</span></div><div class="row grand"><span>Total</span><span>$${sale.total.toFixed(2)}</span></div></div>`;
  printDoc({ title: `Receipt ${sale.invoice}`, docType: "Receipt", docNum: sale.invoice, patient: sale.customer, mrn: "N/A", date: sale.time, body });
}

function inlinePrintPrescription(rx: { number: string; patientName: string; mrn: string; date: string; doctorName: string; items: { name: string; qty: number; dosage: string }[]; }) {
  const body = `<div class="rx-symbol">℞</div><p style="margin-bottom:12px"><strong>Prescribed by:</strong> ${rx.doctorName}</p><table><thead><tr><th>#</th><th>Medication</th><th>Dosage</th><th class="text-right">Qty</th></tr></thead><tbody>${rx.items.map((item,i) => `<tr><td>${i+1}</td><td><strong>${item.name}</strong></td><td>${item.dosage}</td><td class="text-right">${item.qty}</td></tr>`).join("")}</tbody></table>`;
  printDoc({ title: `Prescription ${rx.number}`, docType: "Prescription", docNum: rx.number, patient: rx.patientName, mrn: rx.mrn, date: new Date(rx.date).toLocaleDateString(), body, footer: "This prescription is valid for 30 days." });
}

function inlinePrintInvoice(inv: { number: string; patientName: string; mrn: string; date: string; department: string; items: { description: string; qty: number; rate: number; total: number }[]; amount: number; paid: number; }) {
  const balance = inv.amount - inv.paid;
  const body = `<p style="margin-bottom:12px"><strong>Department:</strong> ${inv.department}</p><table><thead><tr><th>Description</th><th class="text-right">Qty</th><th class="text-right">Rate</th><th class="text-right">Total</th></tr></thead><tbody>${inv.items.map(i => `<tr><td>${i.description}</td><td class="text-right">${i.qty}</td><td class="text-right">$${i.rate.toFixed(2)}</td><td class="text-right">$${i.total.toFixed(2)}</td></tr>`).join("")}</tbody></table><div class="total-section"><div class="row"><span>Subtotal</span><span>$${inv.amount.toFixed(2)}</span></div><div class="row"><span>Paid</span><span>$${inv.paid.toFixed(2)}</span></div><div class="row grand"><span>Balance Due</span><span>$${balance.toFixed(2)}</span></div></div>`;
  printDoc({ title: `Invoice ${inv.number}`, docType: "Invoice", docNum: inv.number, patient: inv.patientName, mrn: inv.mrn, date: new Date(inv.date).toLocaleDateString(), body });
}

const SUPPLIERS = ["PharmaCorp Inc.", "GlobePharma Ltd.", "MediLabs Supplies", "RespiraCare", "DiabeCare Products", "MedEquip Services"];

// === ModalHost ===
export function ModalHost() {
  const { activeModal, closeModal, toasts, dismissToast } = useAppStore();
  return (
    <>
      <AnimatePresence>
        {activeModal && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm"
            onClick={closeModal}
          />
        )}
      </AnimatePresence>
      <AnimatePresence>
        {activeModal === "pos" && <POSModal key="pos" onClose={closeModal} />}
        {activeModal === "return" && <ReturnModal key="ret" onClose={closeModal} />}
        {activeModal === "newPrescription" && <NewPrescriptionModal key="rx" onClose={closeModal} />}
        {activeModal === "newPurchaseOrder" && <PurchaseOrderModal key="po" onClose={closeModal} />}
        {activeModal === "restock" && <RestockModal key="rs" onClose={closeModal} />}
        {activeModal === "newPatient" && <NewPatientModal key="np" onClose={closeModal} />}
        {activeModal === "newInvoice" && <NewInvoiceModal key="ni" onClose={closeModal} />}
        {activeModal === "newAppointment" && <NewAppointmentModal key="na" onClose={closeModal} />}
        {activeModal === "newLabOrder" && <NewLabOrderModal key="nl" onClose={closeModal} />}
        {activeModal === "newExpense" && <NewExpenseModal key="ne" onClose={closeModal} />}
        {activeModal === "admitPatient" && <AdmitPatientModal key="ap" onClose={closeModal} />}
        {activeModal === "newStaff" && <NewStaffModal key="ns" onClose={closeModal} />}
        {activeModal === "sendAnnouncement" && <AnnouncementModal key="an" onClose={closeModal} />}
        {activeModal === "startCall" && <StartCallModal key="sc" onClose={closeModal} />}
        {activeModal === "newNote" && <NewNoteModal key="nn" onClose={closeModal} />}
      </AnimatePresence>
      <ToastStack toasts={toasts} dismissToast={dismissToast} />
    </>
  );
}

function ToastStack({ toasts, dismissToast }: { toasts: any[]; dismissToast: (id: string) => void }) {
  const icons: Record<string, React.ElementType> = { success: CheckCircle2, warning: AlertTriangle, info: FileText, danger: AlertTriangle };
  const colors: Record<string, string> = { success: "border-emerald-200 bg-emerald-50", warning: "border-amber-200 bg-amber-50", info: "border-brand-200 bg-brand-50", danger: "border-rose-200 bg-rose-50" };
  const iconColors: Record<string, string> = { success: "text-emerald-600", warning: "text-amber-600", info: "text-brand-600", danger: "text-rose-600" };
  return (
    <div className="fixed top-4 right-4 z-[200] space-y-2 max-w-sm">
      <AnimatePresence>
        {toasts.map((t) => {
          const Icon = icons[t.variant] || CheckCircle2;
          return (
            <motion.div key={t.id} initial={{ opacity: 0, x: 50, scale: 0.9 }} animate={{ opacity: 1, x: 0, scale: 1 }} exit={{ opacity: 0, x: 50, scale: 0.9 }} className={cn("pointer-events-auto rounded-xl border shadow-premium p-4 flex items-start gap-3", colors[t.variant])}>
              <Icon className={cn("h-5 w-5 shrink-0 mt-0.5", iconColors[t.variant])} />
              <div className="flex-1 min-w-0">
                <p className="text-sm font-semibold">{t.title}</p>
                {t.description && <p className="text-xs text-muted-foreground mt-0.5">{t.description}</p>}
              </div>
              <button onClick={() => dismissToast(t.id)} className="text-muted-foreground hover:text-foreground shrink-0"><X className="h-4 w-4" /></button>
            </motion.div>
          );
        })}
      </AnimatePresence>
    </div>
  );
}

// === ModalShell ===
function ModalShell({ title, subtitle, icon: Icon, iconClass, onClose, children, footer, size = "md" }: any) {
  const sizes: Record<string, string> = { sm: "max-w-md", md: "max-w-lg", lg: "max-w-2xl", xl: "max-w-5xl" };
  return (
    <motion.div initial={{ opacity: 0, scale: 0.95, y: 10 }} animate={{ opacity: 1, scale: 1, y: 0 }} exit={{ opacity: 0, scale: 0.95, y: 10 }} className="fixed inset-0 z-[110] flex items-center justify-center p-4 pointer-events-none">
      <div className={cn("w-full bg-card rounded-2xl shadow-premium border border-border overflow-hidden pointer-events-auto flex flex-col max-h-[90vh]", sizes[size])}>
        <div className="p-5 border-b border-border flex items-start justify-between gap-4">
          <div className="flex items-start gap-3">
            <div className={cn("w-10 h-10 rounded-xl flex items-center justify-center shrink-0", iconClass || "bg-brand-50 text-brand-600")}><Icon className="h-5 w-5" /></div>
            <div><h2 className="text-lg font-semibold">{title}</h2>{subtitle && <p className="text-xs text-muted-foreground mt-0.5">{subtitle}</p>}</div>
          </div>
          <button onClick={onClose} className="w-8 h-8 rounded-lg hover:bg-accent flex items-center justify-center text-muted-foreground"><X className="h-4 w-4" /></button>
        </div>
        <div className="flex-1 overflow-y-auto p-5">{children}</div>
        {footer && <div className="p-4 border-t border-border bg-accent/20">{footer}</div>}
      </div>
    </motion.div>
  );
}

function SubmitFooter({ onClose, onSubmit, label, icon: Icon, disabled }: any) {
  return (
    <div className="flex items-center justify-end gap-2">
      <Button variant="outline" onClick={onClose}>Cancel</Button>
      <Button className="bg-brand-600 hover:bg-brand-700" onClick={onSubmit} disabled={disabled}>{Icon && <Icon className="h-4 w-4 mr-1.5" />}{label}</Button>
    </div>
  );
}

// === POS Modal ===
function POSModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity, addSale } = useAppStore();
  const get = useAppStore.getState;
  const [search, setSearch] = useState("");
  const [cart, setCart] = useState<Record<string, number>>({});
  const [customer, setCustomer] = useState("");
  const [payment, setPayment] = useState<"Cash" | "Card" | "Insurance">("Cash");

  const filtered = useMemo(() => { const q = search.trim().toLowerCase(); return !q ? MEDICINES : MEDICINES.filter((m) => m.name.toLowerCase().includes(q) || m.generic.toLowerCase().includes(q)); }, [search]);
  const cartItems = useMemo(() => Object.entries(cart).map(([id, qty]) => { const med = MEDICINES.find((m) => m.id === id); return med ? { medicineId: id, name: med.name, qty, price: med.price } : null; }).filter(Boolean) as any[], [cart]);
  const subtotal = cartItems.reduce((s, i) => s + i.qty * i.price, 0);
  const tax = subtotal * 0.08;
  const total = subtotal + tax;

  const handleSubmit = () => {
    if (cartItems.length === 0) { pushToast({ title: "Cart is empty", description: "Add at least one medicine", variant: "warning" }); return; }
    const cust = customer.trim() || "Walk-in Customer";
    const saleRecord = addSale({ customer: cust, items: cartItems, subtotal, tax, total, paymentMethod: payment });
    logActivity({ action: "Completed pharmacy sale", category: "pharmacy", details: `${saleRecord.number} · ${cartItems.length} items · ${money(total)} via ${payment} — ${cust}` });
    get().addInvoice({ patientName: cust, mrn: "Walk-in", amount: total, paid: total, department: "Pharmacy", items: cartItems.map((i: any) => ({ description: `${i.name} x${i.qty}`, qty: i.qty, rate: i.price, total: i.price * i.qty })), source: "Pharmacy" });
    pushToast({ title: "Sale Completed ✓", description: `${saleRecord.number} · ${money(total)} — invoice sent to Billing`, variant: "success" });
    inlinePrintReceipt({ invoice: saleRecord.number, customer: cust, time: saleRecord.time, paymentMethod: payment, items: cartItems.map((i: any) => ({ name: i.name, qty: i.qty, price: i.price })), total });
    closeModal();
  };

  return (
    <ModalShell title="Point of Sale" subtitle="Ring up a pharmacy sale" icon={ShoppingCart} iconClass="bg-brand-50 text-brand-600" size="xl" onClose={onClose}
      footer={<div className="flex items-center justify-between gap-4"><div className="text-sm"><span className="text-muted-foreground">Total: </span><span className="text-xl font-bold tabular-nums">{money(total)}</span></div><div className="flex gap-2"><Button variant="outline" onClick={onClose}>Cancel</Button><Button className="bg-brand-600 hover:bg-brand-700" onClick={handleSubmit} disabled={cartItems.length === 0}><CheckCircle2 className="h-4 w-4 mr-1.5" />Complete Sale</Button></div></div>}>
      <div className="grid grid-cols-1 lg:grid-cols-5 gap-4">
        <div className="lg:col-span-3 space-y-3">
          <div className="relative"><Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" /><Input placeholder="Search medicines..." value={search} onChange={(e) => setSearch(e.target.value)} className="pl-9 h-10" autoFocus /></div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-[400px] overflow-y-auto">
            {filtered.map((med) => (
              <button key={med.id} onClick={() => setCart((c) => ({ ...c, [med.id]: (c[med.id] ?? 0) + 1 }))} className="text-left p-3 rounded-lg border border-border bg-card hover:border-brand-300 hover:bg-brand-50/30 transition-all">
                <div className="flex items-start justify-between gap-2"><div className="min-w-0"><p className="text-sm font-semibold truncate">{med.name}</p><p className="text-[11px] text-muted-foreground">{med.generic}</p></div><div className="text-right shrink-0"><p className="text-sm font-bold tabular-nums">${med.price.toFixed(2)}</p><p className="text-[10px] text-muted-foreground">{med.stock} {med.unit}</p></div></div>
              </button>
            ))}
          </div>
        </div>
        <div className="lg:col-span-2 space-y-3">
          <div><Label className="text-xs uppercase text-muted-foreground">Customer</Label><Input value={customer} onChange={(e) => setCustomer(e.target.value)} placeholder="Walk-in Customer" className="h-9 mt-1" /></div>
          <div><Label className="text-xs uppercase text-muted-foreground">Payment Method</Label><div className="grid grid-cols-3 gap-1.5 mt-1">{(["Cash", "Card", "Insurance"] as const).map((m) => { const Icon = m === "Cash" ? Banknote : m === "Card" ? CreditCard : Shield; return <button key={m} onClick={() => setPayment(m)} className={cn("flex flex-col items-center gap-1 p-2 rounded-lg border text-xs font-medium", payment === m ? "border-brand-400 bg-brand-50 text-brand-700" : "border-border")}><Icon className="h-4 w-4" />{m}</button>; })}</div></div>
          <div><Label className="text-xs uppercase text-muted-foreground">Cart ({cartItems.length})</Label><div className="mt-1 space-y-1.5 max-h-[200px] overflow-y-auto">{cartItems.length === 0 ? <div className="text-center py-8 text-xs text-muted-foreground"><ShoppingCart className="h-8 w-8 mx-auto mb-2 opacity-30" />Cart is empty</div> : cartItems.map((item) => (<div key={item.medicineId} className="flex items-center gap-2 p-2 rounded-lg bg-accent/40"><div className="flex-1 min-w-0"><p className="text-xs font-medium truncate">{item.name}</p><p className="text-[10px] text-muted-foreground">${item.price.toFixed(2)} × {item.qty}</p></div><div className="flex items-center gap-1"><button onClick={() => setCart((c) => { const n = { ...c }; if (n[item.medicineId] > 1) n[item.medicineId]--; else delete n[item.medicineId]; return n; })} className="w-6 h-6 rounded-md bg-card border flex items-center justify-center"><Minus className="h-3 w-3" /></button><span className="text-xs font-semibold w-6 text-center">{item.qty}</span><button onClick={() => setCart((c) => ({ ...c, [item.medicineId]: c[item.medicineId] + 1 }))} className="w-6 h-6 rounded-md bg-card border flex items-center justify-center"><Plus className="h-3 w-3" /></button><button onClick={() => setCart((c) => { const n = { ...c }; delete n[item.medicineId]; return n; })} className="w-6 h-6 rounded-md text-rose-600 flex items-center justify-center"><Trash2 className="h-3 w-3" /></button></div></div>))}</div></div>
          {cartItems.length > 0 && <div className="p-3 rounded-lg bg-accent/30 border space-y-1.5 text-xs"><div className="flex justify-between"><span className="text-muted-foreground">Subtotal</span><span className="font-semibold">{money(subtotal)}</span></div><div className="flex justify-between"><span className="text-muted-foreground">Tax (8%)</span><span className="font-semibold">{money(tax)}</span></div><div className="h-px bg-border" /><div className="flex justify-between"><span className="font-semibold">Total</span><span className="font-bold text-base">{money(total)}</span></div></div>}
        </div>
      </div>
    </ModalShell>
  );
}

// === Return Modal ===
function ReturnModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity, addReturn, refundSale, sales } = useAppStore();
  const [medicine, setMedicine] = useState("");
  const [qty, setQty] = useState("1");
  const [reason, setReason] = useState("Expired");
  const [supplier, setSupplier] = useState(SUPPLIERS[0]);
  const [returnType, setReturnType] = useState<"supplier" | "customer">("supplier");

  const handleSubmit = () => {
    const med = MEDICINES.find((m) => m.id === medicine);
    if (returnType === "supplier") {
      if (!med) { pushToast({ title: "Select a medicine", variant: "warning" }); return; }
      const credit = med.price * parseInt(qty);
      addReturn({ saleNumber: "N/A", customer: supplier, amount: credit, reason: `${reason}: ${med.name} ×${qty}` });
      logActivity({ action: "Processed supplier return", category: "pharmacy", details: `${med.name} ×${qty} → ${supplier} (credit: ${money(credit)})` });
      pushToast({ title: "Return Processed ✓", description: `${med.name} ×${qty} → ${supplier}`, variant: "success" });
    } else {
      const recentSale = sales[0];
      if (recentSale) {
        refundSale(recentSale.id);
        addReturn({ saleNumber: recentSale.number, customer: recentSale.customer, amount: recentSale.total, reason });
        logActivity({ action: "Processed customer return", category: "pharmacy", details: `${recentSale.number} refunded — ${money(recentSale.total)}` });
        pushToast({ title: "Customer Return ✓", description: `${recentSale.number} refunded — ${money(recentSale.total)}`, variant: "success" });
        inlinePrintReceipt({ invoice: `REFUND-${recentSale.number}`, customer: recentSale.customer, time: new Date().toLocaleTimeString(), paymentMethod: recentSale.paymentMethod, items: recentSale.items.map((i: any) => ({ name: i.name, qty: -i.qty, price: i.price })), total: -recentSale.total });
      } else { pushToast({ title: "No sales to return", variant: "warning" }); return; }
    }
    closeModal();
  };

  return (
    <ModalShell title="Process Return" subtitle="Return items to supplier or process customer refund" icon={RotateCcw} iconClass="bg-amber-50 text-amber-600" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Process Return" icon={RotateCcw} />}>
      <div className="space-y-4">
        <div className="grid grid-cols-2 gap-2">
          <button onClick={() => setReturnType("supplier")} className={cn("p-3 rounded-lg border text-sm font-medium", returnType === "supplier" ? "border-brand-400 bg-brand-50 text-brand-700" : "border-border")}>Return to Supplier</button>
          <button onClick={() => setReturnType("customer")} className={cn("p-3 rounded-lg border text-sm font-medium", returnType === "customer" ? "border-brand-400 bg-brand-50 text-brand-700" : "border-border")}>Customer Refund</button>
        </div>
        {returnType === "supplier" ? (
          <>
            <div><Label className="text-xs uppercase text-muted-foreground">Medicine</Label><select value={medicine} onChange={(e) => setMedicine(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{MEDICINES.map((m) => <option key={m.id} value={m.id}>{m.name} ({m.stock} {m.unit}s)</option>)}</select></div>
            <div className="grid grid-cols-2 gap-3">
              <div><Label className="text-xs uppercase text-muted-foreground">Quantity</Label><Input type="number" value={qty} onChange={(e) => setQty(e.target.value)} className="h-9 mt-1" /></div>
              <div><Label className="text-xs uppercase text-muted-foreground">Supplier</Label><select value={supplier} onChange={(e) => setSupplier(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm">{SUPPLIERS.map((s) => <option key={s}>{s}</option>)}</select></div>
            </div>
            <div><Label className="text-xs uppercase text-muted-foreground">Reason</Label><select value={reason} onChange={(e) => setReason(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>Expired</option><option>Damaged</option><option>Quality Issue</option><option>Overstocking</option><option>Supplier Error</option><option>Recall</option></select></div>
          </>
        ) : (
          <div className="p-4 rounded-lg bg-accent/30 border border-border">
            <p className="text-sm">This will refund the most recent sale: <strong>{sales[0]?.number || "No sales yet"}</strong></p>
            <p className="text-xs text-muted-foreground mt-1">Customer: {sales[0]?.customer || "N/A"} · Amount: {sales[0] ? money(sales[0].total) : "N/A"}</p>
            <div className="mt-3"><Label className="text-xs uppercase text-muted-foreground">Reason</Label><select value={reason} onChange={(e) => setReason(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>Wrong medicine</option><option>Damaged product</option><option>Expired</option><option>Allergic reaction</option><option>Over-dispensing</option><option>Better alternative</option></select></div>
          </div>
        )}
      </div>
    </ModalShell>
  );
}

// === New Prescription Modal ===
function NewPrescriptionModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const get = useAppStore.getState;
  const [patient, setPatient] = useState("");
  const [doctor, setDoctor] = useState("");
  const [medication, setMedication] = useState("");
  const [dosage, setDosage] = useState("");
  const [frequency, setFrequency] = useState("BID");
  const [duration, setDuration] = useState("7 days");

  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p || !medication.trim()) { pushToast({ title: "Missing details", description: "Patient and medication are required", variant: "warning" }); return; }
    const med = MEDICINES.find((m) => m.name === medication);
    const rxTotal = med ? med.price * 30 : 0;
    get().addPrescription({ patientName: p.name, mrn: p.mrn, prescribedBy: doctor || get().user?.name || "Doctor", items: [{ name: medication, qty: 30, dosage: `${dosage} ${frequency} × ${duration}` }], total: rxTotal, source: "EMR" });
    logActivity({ action: "Created prescription", category: "clinical", details: `${medication} ${dosage} — ${p.name} → sent to Pharmacy` });
    pushToast({ title: "Prescription Created ✓", description: `${medication} → ${p.name} — sent to Pharmacy`, variant: "success" });
    inlinePrintPrescription({ number: `RX-${Date.now()}`, patientName: p.name, mrn: p.mrn, date: new Date().toISOString(), doctorName: doctor || get().user?.name || "Doctor", items: [{ name: medication, qty: 30, dosage: `${dosage} ${frequency} × ${duration}` }] });
    closeModal();
  };

  return (
    <ModalShell title="New Prescription" subtitle="Issue a medication order" icon={Pill} iconClass="bg-brand-50 text-brand-600" size="lg" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Create Prescription" icon={Pill} />}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Patient</Label><select value={patient} onChange={(e) => setPatient(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{PATIENTS.map((p) => <option key={p.id} value={p.id}>{p.name} ({p.mrn})</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Doctor</Label><select value={doctor} onChange={(e) => setDoctor(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Medication</Label><select value={medication} onChange={(e) => setMedication(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{MEDICINES.map((m) => <option key={m.id} value={m.name}>{m.name}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Dosage</Label><Input value={dosage} onChange={(e) => setDosage(e.target.value)} placeholder="e.g., 500mg" className="h-9 mt-1" /></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Frequency</Label><select value={frequency} onChange={(e) => setFrequency(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>BID</option><option>TID</option><option>QID</option><option>OD</option><option>PRN</option></select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Duration</Label><Input value={duration} onChange={(e) => setDuration(e.target.value)} className="h-9 mt-1" /></div>
      </div>
    </ModalShell>
  );
}

// === New Invoice Modal (Context-Aware Billing) ===
function NewInvoiceModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const get = useAppStore.getState;
  const [serviceType, setServiceType] = useState<string>("");
  const [patient, setPatient] = useState("");
  // Consultation fields
  const [doctor, setDoctor] = useState("");
  const [consultType, setConsultType] = useState("New");
  const [consultFee, setConsultFee] = useState("250");
  // Lab fields
  const [testName, setTestName] = useState("");
  const [testType, setTestType] = useState("Hematology");
  const [orderingDoc, setOrderingDoc] = useState("");
  const [testPrice, setTestPrice] = useState("150");
  // Pharmacy fields
  const [medicine, setMedicine] = useState("");
  const [batch, setBatch] = useState("");
  const [pharmQty, setPharmQty] = useState("1");
  const [unitPrice, setUnitPrice] = useState("");
  const [discount, setDiscount] = useState("0");
  // Procedure fields
  const [procName, setProcName] = useState("");
  const [provider, setProvider] = useState("");
  const [sessions, setSessions] = useState("1");
  const [procPrice, setProcPrice] = useState("");
  // Room fields
  const [ward, setWard] = useState("");
  const [roomType, setRoomType] = useState("General");
  const [days, setDays] = useState("1");
  const [dailyRate, setDailyRate] = useState("1000");
  // Other
  const [desc, setDesc] = useState("");
  const [otherQty, setOtherQty] = useState("1");
  const [otherPrice, setOtherPrice] = useState("");

  const { amount, items, department, source } = useMemo(() => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p || !serviceType) return { amount: 0, items: [] as any[], department: "", source: "Manual" as const };
    if (serviceType === "Consultation") {
      const fee = Number(consultFee) || 0;
      return { amount: fee, items: [{ description: `${consultType} Consultation — ${doctor || "Doctor"}`, qty: 1, rate: fee, total: fee }], department: "OPD", source: "Manual" as const };
    }
    if (serviceType === "Laboratory") {
      const price = Number(testPrice) || 0;
      return { amount: price, items: [{ description: `Lab Test: ${testName} (${testType})`, qty: 1, rate: price, total: price }], department: "Laboratory", source: "Lab" as const };
    }
    if (serviceType === "Pharmacy") {
      const qty = Number(pharmQty) || 1;
      const price = Number(unitPrice) || 0;
      const disc = Number(discount) || 0;
      const subtotal = qty * price;
      const total = subtotal - disc;
      return { amount: total, items: [{ description: `${medicine} (Batch: ${batch})`, qty, rate: price, total }], department: "Pharmacy", source: "Pharmacy" as const };
    }
    if (serviceType === "Procedure") {
      const sess = Number(sessions) || 1;
      const price = Number(procPrice) || 0;
      const total = sess * price;
      return { amount: total, items: [{ description: `${procName} — ${provider} (${sess} session(s))`, qty: sess, rate: price, total }], department: "Procedures", source: "Manual" as const };
    }
    if (serviceType === "Room Charge") {
      const d = Number(days) || 1;
      const rate = Number(dailyRate) || 0;
      const total = d * rate;
      return { amount: total, items: [{ description: `${roomType} Room — ${ward} (${d} day(s))`, qty: d, rate, total }], department: "IPD", source: "IPD" as const };
    }
    const qty = Number(otherQty) || 1;
    const price = Number(otherPrice) || 0;
    return { amount: qty * price, items: [{ description: desc, qty, rate: price, total: qty * price }], department: "Other", source: "Manual" as const };
  }, [serviceType, patient, consultFee, consultType, doctor, testName, testType, testPrice, medicine, batch, pharmQty, unitPrice, discount, procName, provider, sessions, procPrice, ward, roomType, days, dailyRate, desc, otherQty, otherPrice]);

  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p || !serviceType || amount <= 0) { pushToast({ title: "Missing details", description: "Patient, service type and valid amount are required", variant: "warning" }); return; }
    get().addInvoice({ patientName: p.name, mrn: p.mrn, amount, paid: 0, department, items, source });
    logActivity({ action: "Created invoice", category: "billing", details: `${p.name} — ${serviceType} — ${money(amount)} (${department})` });
    pushToast({ title: "Invoice Created ✓", description: `${p.name} — ${money(amount)} — visible in Billing`, variant: "success" });
    inlinePrintInvoice({ number: `INV-${Date.now()}`, patientName: p.name, mrn: p.mrn, date: new Date().toISOString(), department, items, amount, paid: 0 });
    closeModal();
  };

  const serviceTypes = [
    { key: "Consultation", label: "Consultation", icon: Stethoscope, color: "bg-brand-50 text-brand-600" },
    { key: "Laboratory", label: "Laboratory", icon: FlaskConical, color: "bg-amber-50 text-amber-600" },
    { key: "Pharmacy", label: "Pharmacy", icon: Pill, color: "bg-emerald-50 text-emerald-600" },
    { key: "Procedure", label: "Procedure", icon: Activity, color: "bg-violet-50 text-violet-600" },
    { key: "Room Charge", label: "Room Charge", icon: BedDouble, color: "bg-rose-50 text-rose-600" },
    { key: "Other", label: "Other", icon: FileText, color: "bg-muted text-muted-foreground" },
  ];

  return (
    <ModalShell title="Create Invoice" subtitle="Context-aware billing — select service type first" icon={FileText} iconClass="bg-brand-50 text-brand-600" size="lg" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label={`Create Invoice · ${money(amount)}`} icon={FileText} disabled={!serviceType || amount <= 0} />}>
      <div className="space-y-4">
        {/* Service Type Selector */}
        {!serviceType ? (
          <div>
            <Label className="text-xs uppercase text-muted-foreground mb-2 block">Select Service Type</Label>
            <div className="grid grid-cols-2 md:grid-cols-3 gap-2">
              {serviceTypes.map((st) => (
                <button key={st.key} onClick={() => setServiceType(st.key)} className="flex flex-col items-center gap-2 p-4 rounded-xl border border-border hover:border-brand-300 hover:bg-brand-50/30 transition-all">
                  <div className={cn("w-10 h-10 rounded-lg flex items-center justify-center", st.color)}><st.icon className="h-5 w-5" /></div>
                  <span className="text-sm font-medium">{st.label}</span>
                </button>
              ))}
            </div>
          </div>
        ) : (
          <div className="flex items-center gap-2 p-2 rounded-lg bg-brand-50 border border-brand-200">
            <span className="text-xs font-medium text-brand-700">Service: {serviceType}</span>
            <button onClick={() => setServiceType("")} className="text-xs text-brand-600 hover:underline ml-auto">Change</button>
          </div>
        )}

        {serviceType && (
          <>
            <div><Label className="text-xs uppercase text-muted-foreground">Patient</Label><select value={patient} onChange={(e) => setPatient(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select patient...</option>{PATIENTS.map((p) => <option key={p.id} value={p.id}>{p.name} ({p.mrn})</option>)}</select></div>

            {serviceType === "Consultation" && (
              <div className="grid grid-cols-2 gap-3">
                <div><Label className="text-xs uppercase text-muted-foreground">Doctor</Label><select value={doctor} onChange={(e) => setDoctor(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Consultation Type</Label><select value={consultType} onChange={(e) => setConsultType(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>New</option><option>Follow-up</option><option>Emergency</option></select></div>
                <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Consultation Fee ($)</Label><Input type="number" value={consultFee} onChange={(e) => setConsultFee(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {serviceType === "Laboratory" && (
              <div className="grid grid-cols-2 gap-3">
                <div><Label className="text-xs uppercase text-muted-foreground">Test Name</Label><Input value={testName} onChange={(e) => setTestName(e.target.value)} placeholder="e.g., CBC" className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Test Type</Label><select value={testType} onChange={(e) => setTestType(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>Hematology</option><option>Chemistry</option><option>Microbiology</option><option>Pathology</option><option>Radiology</option></select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Ordering Doctor</Label><select value={orderingDoc} onChange={(e) => setOrderingDoc(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Test Price ($)</Label><Input type="number" value={testPrice} onChange={(e) => setTestPrice(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {serviceType === "Pharmacy" && (
              <div className="grid grid-cols-2 gap-3">
                <div><Label className="text-xs uppercase text-muted-foreground">Medicine</Label><select value={medicine} onChange={(e) => { setMedicine(e.target.value); const med = MEDICINES.find((m) => m.id === e.target.value); if (med) setUnitPrice(med.price.toString()); }} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{MEDICINES.map((m) => <option key={m.id} value={m.id}>{m.name}</option>)}</select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Batch Number</Label><Input value={batch} onChange={(e) => setBatch(e.target.value)} placeholder="e.g., BATCH-001" className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Quantity</Label><Input type="number" value={pharmQty} onChange={(e) => setPharmQty(e.target.value)} className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Unit Price ($)</Label><Input type="number" value={unitPrice} onChange={(e) => setUnitPrice(e.target.value)} className="h-9 mt-1" /></div>
                <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Discount ($)</Label><Input type="number" value={discount} onChange={(e) => setDiscount(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {serviceType === "Procedure" && (
              <div className="grid grid-cols-2 gap-3">
                <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Procedure Name</Label><Input value={procName} onChange={(e) => setProcName(e.target.value)} placeholder="e.g., Echocardiography" className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Performing Provider</Label><select value={provider} onChange={(e) => setProvider(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Sessions</Label><Input type="number" value={sessions} onChange={(e) => setSessions(e.target.value)} className="h-9 mt-1" /></div>
                <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Price per Session ($)</Label><Input type="number" value={procPrice} onChange={(e) => setProcPrice(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {serviceType === "Room Charge" && (
              <div className="grid grid-cols-2 gap-3">
                <div><Label className="text-xs uppercase text-muted-foreground">Ward</Label><select value={ward} onChange={(e) => setWard(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option><option>ICU</option><option>CCU</option><option>General Ward A</option><option>General Ward B</option><option>Pediatric</option><option>Maternity</option></select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Room Type</Label><select value={roomType} onChange={(e) => setRoomType(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option>General</option><option>Private</option><option>Semi-Private</option><option>ICU</option><option>Suite</option></select></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Days</Label><Input type="number" value={days} onChange={(e) => setDays(e.target.value)} className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Daily Rate ($)</Label><Input type="number" value={dailyRate} onChange={(e) => setDailyRate(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {serviceType === "Other" && (
              <div className="grid grid-cols-2 gap-3">
                <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Description</Label><Input value={desc} onChange={(e) => setDesc(e.target.value)} placeholder="Service description" className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Quantity</Label><Input type="number" value={otherQty} onChange={(e) => setOtherQty(e.target.value)} className="h-9 mt-1" /></div>
                <div><Label className="text-xs uppercase text-muted-foreground">Unit Price ($)</Label><Input type="number" value={otherPrice} onChange={(e) => setOtherPrice(e.target.value)} className="h-9 mt-1" /></div>
              </div>
            )}

            {/* Live total */}
            {amount > 0 && (
              <div className="p-3 rounded-lg bg-brand-50 border border-brand-200 flex items-center justify-between">
                <span className="text-sm text-brand-700">Total Amount:</span>
                <span className="text-lg font-bold text-brand-700 tabular-nums">{money(amount)}</span>
              </div>
            )}
          </>
        )}
      </div>
    </ModalShell>
  );
}

// === New Lab Order Modal ===
function NewLabOrderModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const get = useAppStore.getState;
  const [patient, setPatient] = useState("");
  const [doctor, setDoctor] = useState("");
  const [tests, setTests] = useState("");
  const [priority, setPriority] = useState("routine");

  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p || !tests.trim()) { pushToast({ title: "Missing details", description: "Patient and tests are required", variant: "warning" }); return; }
    const testList = tests.split(",").map((t) => t.trim()).filter(Boolean);
    get().addLabOrder({ patientName: p.name, mrn: p.mrn, orderedBy: get().user?.name || "Doctor", tests: testList, priority: priority as any, source: "EMR" });
    get().addInvoice({ patientName: p.name, mrn: p.mrn, amount: testList.length * 150, paid: 0, department: "Laboratory", items: testList.map((t) => ({ description: `Lab Test: ${t}`, qty: 1, rate: 150, total: 150 })), source: "Lab" });
    logActivity({ action: "Placed lab order", category: "clinical", details: `${testList.join(", ")} — ${p.name} → sent to Lab & Billing` });
    pushToast({ title: "Lab Order Placed ✓", description: `${testList.length} test(s) for ${p.name} — sent to Lab, invoice to Billing`, variant: "success" });
    closeModal();
  };

  return (
    <ModalShell title="New Lab Order" subtitle="Order lab tests for a patient" icon={FlaskConical} iconClass="bg-violet-50 text-violet-600" size="lg" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Place Lab Order" icon={FlaskConical} />}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Patient</Label><select value={patient} onChange={(e) => setPatient(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{PATIENTS.map((p) => <option key={p.id} value={p.id}>{p.name} ({p.mrn})</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Ordering Doctor</Label><select value={doctor} onChange={(e) => setDoctor(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{DOCTORS.map((d) => <option key={d.id} value={d.name}>{d.name}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Priority</Label><select value={priority} onChange={(e) => setPriority(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="routine">Routine</option><option value="urgent">Urgent</option><option value="stat">STAT</option></select></div>
        <div className="col-span-2"><Label className="text-xs uppercase text-muted-foreground">Tests (comma-separated)</Label><Input value={tests} onChange={(e) => setTests(e.target.value)} placeholder="e.g., CBC, Lipid Panel, BMP" className="h-9 mt-1" /></div>
      </div>
    </ModalShell>
  );
}

// === Simple modals (form + toast + log) ===
function SimpleModal({ title, subtitle, icon: Icon, iconClass, onClose, fields, submitLabel, onSubmit }: any) {
  return (
    <ModalShell title={title} subtitle={subtitle} icon={Icon} iconClass={iconClass} onClose={onClose}
      footer={<SubmitFooter onClose={onClose} onSubmit={onSubmit} label={submitLabel} icon={Icon} />}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">{fields}</div>
    </ModalShell>
  );
}

function PurchaseOrderModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [supplier, setSupplier] = useState(SUPPLIERS[0]);
  const [medicine, setMedicine] = useState("");
  const [qty, setQty] = useState("100");
  const handleSubmit = () => {
    if (!medicine) { pushToast({ title: "Select medicine", variant: "warning" }); return; }
    const med = MEDICINES.find((m) => m.id === medicine);
    logActivity({ action: "Created purchase order", category: "pharmacy", details: `${qty} units of ${med?.name} from ${supplier}` });
    pushToast({ title: "Purchase Order Created ✓", description: `${qty} units of ${med?.name} — ${supplier}`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="New Purchase Order" subtitle="Order stock from a supplier" icon={Package} iconClass="bg-violet-50 text-violet-600" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Create Order" icon={Package} />}>
      <div className="space-y-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Supplier</Label><select value={supplier} onChange={(e) => setSupplier(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm">{SUPPLIERS.map((s) => <option key={s}>{s}</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Medicine</Label><select value={medicine} onChange={(e) => setMedicine(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{MEDICINES.map((m) => <option key={m.id} value={m.id}>{m.name} (stock: {m.stock})</option>)}</select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Quantity</Label><Input type="number" value={qty} onChange={(e) => setQty(e.target.value)} className="h-9 mt-1" /></div>
      </div>
    </ModalShell>
  );
}

function RestockModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [medicine, setMedicine] = useState("");
  const [qty, setQty] = useState("100");
  const [batch, setBatch] = useState("");
  const handleSubmit = () => {
    if (!medicine) { pushToast({ title: "Select medicine", variant: "warning" }); return; }
    const med = MEDICINES.find((m) => m.id === medicine);
    logActivity({ action: "Restocked medicine", category: "pharmacy", details: `Added ${qty} units to ${med?.name} (batch: ${batch})` });
    pushToast({ title: "Stock Updated ✓", description: `Added ${qty} units to ${med?.name}`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="Restock Medicine" subtitle="Add new stock to inventory" icon={Package} iconClass="bg-emerald-50 text-emerald-600" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Update Stock" icon={CheckCircle2} />}>
      <div className="space-y-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Medicine</Label><select value={medicine} onChange={(e) => setMedicine(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{MEDICINES.map((m) => <option key={m.id} value={m.id}>{m.name} (current: {m.stock})</option>)}</select></div>
        <div className="grid grid-cols-2 gap-3">
          <div><Label className="text-xs uppercase text-muted-foreground">Quantity</Label><Input type="number" value={qty} onChange={(e) => setQty(e.target.value)} className="h-9 mt-1" /></div>
          <div><Label className="text-xs uppercase text-muted-foreground">Batch</Label><Input value={batch} onChange={(e) => setBatch(e.target.value)} placeholder="BATCH-001" className="h-9 mt-1" /></div>
        </div>
      </div>
    </ModalShell>
  );
}

function NewPatientModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [name, setName] = useState(""); const [age, setAge] = useState(""); const [gender, setGender] = useState("M"); const [phone, setPhone] = useState("");
