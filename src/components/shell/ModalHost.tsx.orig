function NewAppointmentModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [patient, setPatient] = useState(""); const [doctor, setDoctor] = useState(""); const [date, setDate] = useState(""); const [time, setTime] = useState(""); const [reason, setReason] = useState("");
  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p || !date || !time) { pushToast({ title: "Missing fields", variant: "warning" }); return; }
    logActivity({ action: "Booked appointment", category: "patient", details: `${p.name} on ${date} at ${time}` });
    pushToast({ title: "Appointment Booked ✓", description: `${p.name} — ${date} ${time}`, variant: "success" });
