  return (
    <ModalShell title="Register New Patient" subtitle="Add a new patient" icon={User} onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Register Patient" icon={CheckCircle2} />}>
