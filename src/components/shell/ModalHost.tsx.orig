    logActivity({ action: "Registered new patient", category: "patient", details: `${name} (${age || "?"}y ${gender}) — ${phone}` });
    pushToast({ title: "Patient Registered ✓", description: `${name} added to registry`, variant: "success" });
    closeModal();
