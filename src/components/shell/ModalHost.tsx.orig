function AnnouncementModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [channel, setChannel] = useState("admin"); const [subject, setSubject] = useState(""); const [message, setMessage] = useState("");
  const handleSubmit = () => {
    if (!subject || !message) { pushToast({ title: "Missing fields", variant: "warning" }); return; }
    logActivity({ action: "Sent announcement", category: "system", details: `To ${channel} — ${subject}` });
    pushToast({ title: "Announcement Sent ✓", description: `Posted to ${channel}`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="Send Announcement" subtitle="Broadcast a message" icon={Megaphone} iconClass="bg-violet-50 text-violet-600" onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Send Announcement" icon={Megaphone} />}>
      <div className="space-y-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Channel</Label><select value={channel} onChange={(e) => setChannel(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="admin">Administration</option><option value="cardiology">Cardiology</option><option value="er">Emergency</option><option value="pharmacy">Pharmacy</option></select></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Subject</Label><Input value={subject} onChange={(e) => setSubject(e.target.value)} className="h-9 mt-1" /></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Message</Label><Textarea value={message} onChange={(e) => setMessage(e.target.value)} rows={4} className="mt-1" /></div>
      </div>
    </ModalShell>
  );
}

function StartCallModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [patient, setPatient] = useState("");
  const handleSubmit = () => {
    const p = PATIENTS.find((x) => x.id === patient);
    if (!p) { pushToast({ title: "Select patient", variant: "warning" }); return; }
    logActivity({ action: "Started video consultation", category: "patient", details: `Connecting to ${p.name}` });
    pushToast({ title: "Starting call...", description: `Connecting to ${p.name}`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="Start Video Consultation" subtitle="Begin a telemedicine call" icon={Video} onClose={onClose}
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Start Call" icon={Video} />}>
      <div className="space-y-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Patient</Label><select value={patient} onChange={(e) => setPatient(e.target.value)} className="w-full h-9 mt-1 px-3 rounded-lg border border-border bg-card text-sm"><option value="">Select...</option>{PATIENTS.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}</select></div>
      </div>
    </ModalShell>
  );
}

function NewNoteModal({ onClose }: { onClose: () => void }) {
  const { closeModal, pushToast, logActivity } = useAppStore();
  const [noteType, setNoteType] = useState("Progress"); const [content, setContent] = useState("");
  const handleSubmit = () => {
    if (!content.trim()) { pushToast({ title: "Missing content", variant: "warning" }); return; }
    logActivity({ action: `Wrote ${noteType} note`, category: "emr", details: content.substring(0, 80) });
    pushToast({ title: "Clinical Note Saved ✓", description: `${noteType} note saved`, variant: "success" });
    closeModal();
  };
  return (
    <ModalShell title="Write Clinical Note" subtitle="Document patient encounter" icon={FileText} onClose={onClose} size="lg"
      footer={<SubmitFooter onClose={closeModal} onSubmit={handleSubmit} label="Save Note" icon={CheckCircle2} />}>
      <div className="space-y-4">
        <div><Label className="text-xs uppercase text-muted-foreground">Note Type</Label><div className="flex flex-wrap gap-1.5 mt-1">{["SOAP", "Progress", "Nursing", "Admission", "Discharge"].map((t) => <button key={t} onClick={() => setNoteType(t)} className={cn("px-3 py-1.5 rounded-lg text-xs font-medium border", noteType === t ? "bg-brand-50 text-brand-700 border-brand-300" : "border-border")}>{t}</button>)}</div></div>
        <div><Label className="text-xs uppercase text-muted-foreground">Note Content</Label><Textarea value={content} onChange={(e) => setContent(e.target.value)} rows={8} className="mt-1" placeholder="Write the clinical note here..." /></div>
      </div>
    </ModalShell>
  );
}
