# ---------------------------------------------------------------------------
# MediCore Hospital Management System — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project (staging and production use separate projects)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-anon-key>"

# Server only. Bypasses RLS. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres connection strings (server / CI only)
DATABASE_URL=""
DIRECT_URL=""

# Runtime environment: local | staging | production
APP_ENV="local"
