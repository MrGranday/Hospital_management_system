# ---------------------------------------------------------------------------
# MediCore Hospital Management System — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Prisma datasource (schema.prisma currently uses SQLite)
DATABASE_URL="file:./dev.db"

# Auth / session (next-auth is installed but not yet wired up)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional AI provider (dependency `z-ai-web-dev-sdk` is installed but unused)
# ZAI_API_KEY=""

# Optional integrations referenced in Settings UI (none are implemented yet)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# STRIPE_SECRET_KEY=""
# SENDGRID_API_KEY=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
